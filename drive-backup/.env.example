# انسخ هذا الملف باسم .env محليًا للتجربة (لا تشاركه مع أحد).
# على GitHub، نفس هالأسماء تنضاف كـ Secrets بدل ملف .env — راجع README.md

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# استخدم مفتاح service_role (Project Settings → API)، مو الـ anon key —
# هالبرنامج ما بيشتغل جوا متصفح، فبيحتاج يقرأ كل بيانات المبيعات
# والمصروفات بدون قيود RLS
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# بيانات OAuth لحسابك الشخصي على Google (مش حساب خدمة — حسابات الخدمة
# ما إلها مساحة تخزين خاصة فيها، فما تقدر تنشئ ملفات جديدة بحساب Drive
# شخصي عادي). راجع README.md لخطوات الحصول على الثلاثة قيم تحت
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّف مجلد Google Drive اللي رح تترفع فيه التقارير (من رابط المجلد
# نفسه بمتصفحك: drive.google.com/drive/folders/<هاد الجزء>)
GDRIVE_BACKUP_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# المنطقة الزمنية لحساب "أمس" بشكل صحيح (تاريخ اليوم المحاسبي المكتمل)
TIMEZONE=Asia/Amman
